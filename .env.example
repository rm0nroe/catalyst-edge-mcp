# Required primary-source identity. Use a real monitored contact address.
CATALYST_EDGE_SEC_USER_AGENT=

# Conditional vendor credentials. A key does not establish commercial rights;
# these remain disabled until the deployed source-policy registry records approval.
FMP_API_KEY=
FINNHUB_API_KEY=
FLOWALGO_API_KEY=
CHEDDARFLOW_API_KEY=

# Options default to unavailable. yfinance is explicit private diagnostic mode only.
CATALYST_EDGE_OPTIONS_PROVIDER=none
# No sentiment model or lexicon currently passes every production gate.
CATALYST_EDGE_SENTIMENT_MODEL=disabled
CATALYST_EDGE_TRANSPORT=stdio
CATALYST_EDGE_HOST=127.0.0.1
CATALYST_EDGE_PORT=8000
# Public self-serve defaults are fail-closed. Enable only after reviewing the exact
# source terms, output attribution, retention, and current source-rights matrix.
CATALYST_EDGE_ISSUER_FEEDS=disabled
CATALYST_EDGE_GDELT=disabled
# Automatic out-of-band GDELT catch-up cadence and freshness threshold.
CATALYST_EDGE_GDELT_REFRESH_SECONDS=300
CATALYST_EDGE_GDELT_LOOKBACK_DAYS=14
CATALYST_EDGE_GDELT_MAX_AGE_SECONDS=900
CATALYST_EDGE_BLUESKY=disabled
# Optional strict local JSON registry; defaults to the packaged reviewed registry.
CATALYST_EDGE_REGISTRY_PATH=
# Optional local SQLite/WAL state for reviewed feeds, event graph, and attention buckets.
CATALYST_EDGE_EVIDENCE_STORE=
