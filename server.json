{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.rm0nroe/catalyst-edge-mcp",
  "title": "Catalyst Edge",
  "description": "Deterministic, source-linked catalyst evidence dossiers for public-company tickers.",
  "version": "0.1.1",
  "repository": {
    "url": "https://github.com/rm0nroe/catalyst-edge-mcp",
    "source": "github",
    "id": "1300950828"
  },
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "catalyst-edge-mcp",
      "version": "0.1.1",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "CATALYST_EDGE_SEC_USER_AGENT",
          "description": "Optional SEC-compliant identity in Company email@example.com form.",
          "isRequired": false,
          "isSecret": false
        },
        {
          "name": "CATALYST_EDGE_EVIDENCE_STORE",
          "description": "Optional local SQLite evidence-store path.",
          "format": "filepath",
          "isRequired": false,
          "isSecret": false
        }
      ]
    }
  ]
}
